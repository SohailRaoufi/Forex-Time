{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forex Time",
  "version": "0.1.0",
  "identifier": "com.forextime.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Forex Time",
        "width": 880,
        "height": 880,
        "minWidth": 360,
        "minHeight": 260,
        "backgroundColor": "#0b1018",
        "decorations": false,
        "alwaysOnTop": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
