{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forex Time",
  "version": "0.1.0",
  "identifier": "com.forextime.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Forex Time",
        "width": 940,
        "height": 600,
        "minWidth": 360,
        "minHeight": 300,
        "backgroundColor": "#0c1119",
        "decorations": false,
        "alwaysOnTop": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "publisher": "Sohail Raoufi",
    "category": "Finance",
    "shortDescription": "Four Forex sessions at a glance",
    "longDescription": "A lightweight desktop clock for Sydney, Tokyo, London and New York, with automatic daylight saving adjustments, a session timeline and a compact floating view.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    }
  }
}
